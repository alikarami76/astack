{% extends "shell.html.j2" %}
{% block body %}
{% if doc.cover %}
<section class="cover">
  {% if meta.kicker %}<p class="cover-kicker">{{ meta.kicker }}</p>{% endif %}
  <div class="cover-title">{{ meta.title }}</div>
  {% if meta.subtitle %}<p class="cover-subtitle">{{ meta.subtitle }}</p>{% endif %}
  <p class="cover-meta">{% if meta.author %}<span>{{ meta.author }}</span>{% endif %}<span>{{ meta.date_display }}</span></p>
</section>
{% endif %}
{% if doc.toc and toc %}
<nav class="toc">
  <h2 class="toc-title">{{ labels.toc }}</h2>
  <ol>
  {% for h in toc %}
    <li class="toc-l{{ h.level }}"><a href="#{{ h.id }}">{{ h.text }}</a></li>
  {% endfor %}
  </ol>
</nav>
{% endif %}
<main class="report-body">
{{ body }}
</main>
{% endblock %}
